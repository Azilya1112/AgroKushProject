DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=36000000
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/agro_kush
# Origins the app is served from — required even behind a same-origin proxy: Spring 6
# validates any request carrying an Origin header, and browsers send Origin on every
# non-GET request, including same-origin ones. Comma-separated, scheme+host+port, no slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
